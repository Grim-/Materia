<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <Materia.MateriaDef ParentName="BaseMateria">
    <defName>ArmorSharpMateria_I</defName>
    <label>Sharp Armor Materia I</label>
    <description>A green crystalline orb pulsing with protective energy. Enhances defense against sharp damage.</description>
    <texPath>Materia/Materia_green_low</texPath>
    <graphicData>
      <texPath>Materia/Materia_green_low</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <commonality>1.0</commonality>
    <SlotType>GreenMateria</SlotType>
    <materiaCategories>
        <li>MateriaCategory_Armor</li>
    </materiaCategories>
    <effects>
      <li>MateriaEffect_ArmorSharp_I</li>
    </effects>
    <textColor>(0.8, 0, 0)</textColor>
    <breakdownMaterials>
      <li>
        <thing>RedMateriaDust</thing>
        <amount>4~8</amount>
      </li>
    </breakdownMaterials>
  </Materia.MateriaDef>

  <Materia.MateriaEffectDef_PawnStatOffset>
    <defName>MateriaEffect_ArmorSharp_I</defName>
    <label>Sharp Armor Enhancement I</label>
    <description>Increases sharp damage armor rating.</description>
    <workerClass>Materia.MateriaEffect_PawnStatOffset</workerClass>
    <statToAffect>ArmorRating_Sharp</statToAffect>
    <statOffset>0.2</statOffset>
  </Materia.MateriaEffectDef_PawnStatOffset>
</Defs>
