<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <AbilityDef>
    <defName>Thor_WeaponThrow</defName>
    <label>Weapon Throw</label>
    <description>Throw your equipped weapon.</description>
    <hostile>true</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>25</range>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="Thor.CompProperties_WeaponThrow">
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>Thor_ThunderClap</defName>
    <label>ThunderClap</label>
    <description>hunderClap.</description>
    <hostile>true</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>25</range>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="Thor.CompProperties_LightningRing">
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>Thor_ChainLightning</defName>
    <label>Thor_ChainLightning</label>
    <description>Thor_ChainLightning.</description>
    <hostile>true</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>25</range>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="Thor.CompProperties_ChainLightning">
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Thor_MjolnirProjectile</defName>
    <label>Fire Arrow</label>
    <thingClass>Thor.Projectile_MjolnirRebound</thingClass>
    <graphicData>
      <texPath>Mjolnir</texPath>
      <graphicClass>Thor.Graphic_SpinningProjectile</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>1</drawSize>
      <drawRotated>true</drawRotated>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <explosionRadius>10</explosionRadius>
      <speed>50</speed>
    </projectile>
  </ThingDef>

</Defs>
